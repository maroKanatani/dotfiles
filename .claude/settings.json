{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "BASH_MAX_TIMEOUT_MS": "1200000",
    "DISABLE_AUTOUPDATER": "0",
    "ENABLE_TOOL_SEARCH": "true"
  },
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(touch:*)",
      "Bash(mkdir:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(rm:*)",
      "Read(**)",
      "Edit(**)",
      "WebFetch(domain:*)",
      "Bash(node:*)",
      "Bash(pnpm:*)",
      "Bash(find:*)",
      "WebFetch(domain:code.visualstudio.com)",
      "WebFetch(domain:docs.cursor.com)",
      "WebFetch(domain:docs.cline.bot)",
      "WebFetch(domain:docs.roo.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:github.com)",
      "Bash(gh release create:*)",
      "Agent",
      "Skill",
      "ToolSearch",
      "Bash(codex:*)",
      "Bash(jq:*)",
      "Bash(yq:*)",
      "Bash(python3:*)",
      "Bash(python:*)",
      "Bash(bash:*)",
      "Bash(awk:*)",
      "Bash(sed:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(echo:*)",
      "Bash(diff:*)",
      "Bash(which:*)",
      "Bash(test:*)"
    ],
    "deny": [
      "Bash(rm -rf ~/**)",
      "Bash(rm -rf //**)",
      "Bash(git remote add:*)",
      "Bash(git remote set-url:*)",
      "Bash(npm publish:*)",
      "Bash(pnpm publish:*)",
      "Read(tmp/**/*)",
      "Read(node_modules/)",
      "Read(*.log)",
      "Read(.env*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "outputStyle": "structured-reporting",
  "language": "japanese",
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "remoteControlAtStartup": false,
  "skipAutoPermissionPrompt": true
}
